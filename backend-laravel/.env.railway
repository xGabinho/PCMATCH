APP_NAME=PCMATCH
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-backend.railway.app

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# CORS y Sanctum
FRONTEND_URL=https://tu-frontend.railway.app
SANCTUM_STATEFUL_DOMAINS=tu-frontend.railway.app
SESSION_DOMAIN=.railway.app

# SMTP — Configurar con un servicio real (Resend, Gmail, Mailgun)
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@pcmatch.com"
MAIL_FROM_NAME="PCMATCH"

# Supabase Storage (si se usa)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true
