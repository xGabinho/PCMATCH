APP_NAME=PCMATCH
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pcmatch-backend.onrender.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Conexión a Base de Datos (Supabase PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.kmqwzlpzpqyykofibfnm
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# CORS y Frontend URL (Vercel)
FRONTEND_URL=https://tu-frontend.vercel.app
SANCTUM_STATEFUL_DOMAINS=tu-frontend.vercel.app
SESSION_DOMAIN=.vercel.app

# Gemini AI (Chatbot & Recomendaciones)
GEMINI_API_KEY=

# Supabase Storage (S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=componentes
AWS_ENDPOINT=https://kmqwzlpzpqyykofibfnm.storage.supabase.co/storage/v1/s3
AWS_URL=https://kmqwzlpzpqyykofibfnm.supabase.co/storage/v1/object/public/componentes
AWS_USE_PATH_STYLE_ENDPOINT=true

# SMTP — Configuración de Correo
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@pcmatch.com"
MAIL_FROM_NAME="PCMATCH"
